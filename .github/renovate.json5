{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    "github>zewelor/renovate-config//presets/github-actions",
    "github>zewelor/renovate-config//presets/go",
    "github>zewelor/renovate-config//presets/postgresql-18",
  ],
  "enabledManagers": [
    "docker-compose",
    "dockerfile",
    "github-actions",
    "gomod",
    "mise",
  ],
  "dependencyDashboard": true,
  "ignoreDeps": ["ghcr.io/zewelor/feedway"],
  "ignorePaths": [".agents/**"],
  "packageRules": [
    {
      "description": "Automerge non-major Go and Docker updates",
      "matchManagers": ["docker-compose", "dockerfile", "gomod"],
      "matchUpdateTypes": ["digest", "minor", "patch", "pin"],
      "automerge": true,
    },
  ],
}
